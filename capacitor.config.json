{
  "appId": "app.lotolab.jogos",
  "appName": "LotoLab",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "BackgroundRunner": {
      "label": "app.lotolab.jogos.conferencia",
      "src": "runner/segundo-plano.js",
      "event": "conferirSorteios",
      "repeat": true,
      "interval": 30,
      "autoStart": true
    }
  }
}

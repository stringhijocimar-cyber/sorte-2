<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Rede.

         Este bloco removia a permissão de rede com tools:node="remove". Era
         correto quando foi escrito: o app funcionava inteiramente offline, os
         resultados eram digitados à mão, e declarar zero permissões era uma
         garantia real de privacidade.

         Deixou de ser verdade quando o app passou a buscar os concursos. E a
         permissão continuou removida, então TODA busca falhava com "Failed to
         fetch" dentro do APK — inclusive a do próprio repositório, que tem
         CORS liberado. O sintoma parecia problema de fonte ou de CORS e era
         falta de acesso à rede.

         O que o app faz com ela: GET em arquivos públicos de resultado. Não
         envia dado nenhum — os jogos continuam só no aparelho, em
         localStorage. usesCleartextTraffic segue em false, então todo tráfego
         é HTTPS. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Avisos no celular.

         POST_NOTIFICATIONS é exigida a partir do Android 13; sem ela o sistema
         descarta a notificação em silêncio e o app parece simplesmente não
         avisar. RECEIVE_BOOT_COMPLETED faz o lembrete do próximo sorteio
         sobreviver a reiniciar o aparelho: sem ela, quem desliga o celular à
         noite perde o aviso da manhã seguinte. As três vêm do plugin de
         notificações locais e estão declaradas aqui para ficarem visíveis a
         quem lê este arquivo, em vez de aparecerem por mágica na fusão. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Esta permissão de assinatura, injetada pelo androidx.core, JÁ FOI
         removida daqui. A justificativa era que nada no app registrava
         BroadcastReceiver — e isso era verdade até o plugin de notificações
         locais entrar, com três receivers (alarme, dispensa e restauração
         após reinício). Mantê-la removida deixaria os avisos agendados sem
         funcionar, e o defeito seria invisível: o app instala, abre e roda
         normalmente; só o aviso nunca chega.

         É o mesmo erro que já custou caro aqui: INTERNET estava removida com
         a mesma justificativa, correta quando o app era offline e errada
         assim que ele passou a buscar resultados. Um APK que não declara o
         que usa não é enxuto, é quebrado. -->

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:screenOrientation="portrait"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- INTERNET é a ÚNICA permissão do app, e existe por um motivo só:
         a busca opcional do resultado de um concurso já sorteado no serviço
         público da Caixa (servicebus2.caixa.gov.br), na aba Conferir.

         Nada mais usa rede. O app continua funcionando inteiro sem conexão —
         gerar, salvar e conferir jogos digitando o resultado à mão. Nenhum
         jogo é enviado: a consulta leva apenas a modalidade e o número do
         concurso. Sem armazenamento externo, sem localização, sem câmera,
         sem identificadores, sem rastreador. Tudo fica em localStorage.

         INTERNET é permissão normal: não gera diálogo em tempo de execução,
         mas aparece na ficha da loja — e é isso que a LOJA.md declara. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- O androidx.core injeta esta permissão de assinatura no manifesto de
         quem o usa, para dar suporte a ContextCompat.registerReceiver. Nada
         neste app nem no Capacitor registra BroadcastReceiver — conferido no
         código-fonte das dependências. Removida para que o APK declare
         literalmente zero permissões. -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:screenOrientation="portrait"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>
</manifest>

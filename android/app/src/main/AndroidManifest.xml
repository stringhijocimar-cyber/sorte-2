<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Nenhuma permissão é declarada de propósito.
         O app não usa rede, armazenamento externo, localização, câmera nem
         identificadores. Tudo fica em localStorage, no aparelho.
         A linha abaixo remove a permissão INTERNET que bibliotecas incluídas
         (Capacitor / AndroidX) trazem no próprio manifesto: sem ela o APK
         final declara zero permissões. O conteúdo é servido de assets/
         pelo WebViewAssetLoader, que não passa pela rede. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <!-- O androidx.core injeta esta permissão de assinatura no manifesto de
         quem o usa, para dar suporte a ContextCompat.registerReceiver. Nada
         neste app nem no Capacitor registra BroadcastReceiver — conferido no
         código-fonte das dependências. Removida para que o APK declare
         literalmente zero permissões. -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:screenOrientation="portrait"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>
</manifest>

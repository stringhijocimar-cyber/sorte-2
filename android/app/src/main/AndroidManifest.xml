<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- INTERNET, e só ela.

         Este bloco removia a permissão de rede com tools:node="remove". Era
         correto quando foi escrito: o app funcionava inteiramente offline, os
         resultados eram digitados à mão, e declarar zero permissões era uma
         garantia real de privacidade.

         Deixou de ser verdade quando o app passou a buscar os concursos. E a
         permissão continuou removida, então TODA busca falhava com "Failed to
         fetch" dentro do APK — inclusive a do próprio repositório, que tem
         CORS liberado. O sintoma parecia problema de fonte ou de CORS e era
         falta de acesso à rede.

         O que o app faz com ela: GET em arquivos públicos de resultado. Não
         envia dado nenhum — os jogos continuam só no aparelho, em
         localStorage. usesCleartextTraffic segue em false, então todo tráfego
         é HTTPS. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- O androidx.core injeta esta permissão de assinatura no manifesto de
         quem o usa, para dar suporte a ContextCompat.registerReceiver. Nada
         neste app nem no Capacitor registra BroadcastReceiver — conferido no
         código-fonte das dependências. Removida para que o APK declare
         literalmente zero permissões. -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:screenOrientation="portrait"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fundo do app. Acompanha o tema escuro do LotoLab (#0c1020), que é o
         padrão desde a virada visual. A splash usa esta cor: se ela ficasse na
         antiga, o app abriria num azul e trocaria para outro meio segundo
         depois — um salto que se vê e não se explica. -->
    <color name="naval">#0c1020</color>

    <!-- O fundo do ÍCONE fica onde estava, de propósito. A arte do trevo foi
         desenhada e conferida sobre este tom, e mudá-lo junto alteraria o
         ícone na tela inicial de quem já instalou, sem que ninguém tivesse
         pedido. Cor de app e cor de ícone são duas decisões, não uma. -->
    <color name="ic_launcher_background">#0F1E2E</color>

    <color name="colorPrimary">#0c1020</color>
    <color name="colorPrimaryDark">#090d18</color>
    <!-- Roxo de destaque, alinhado aos controles da experiência 4.14. -->
    <color name="colorAccent">#9b79e4</color>
</resources>
